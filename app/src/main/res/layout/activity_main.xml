<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#121212"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pulse Link"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etRoomCode"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:hint="Oda Kodu (Varsayılan: 1234)"
        android:text="1234"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:background="#222222"
        android:padding="10dp"
        android:gravity="center"
        android:inputType="number"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:hint="Sinyalleşme URL"
        android:textColor="#AAAAAA"
        android:textSize="11sp"
        android:background="#222222"
        android:padding="8dp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="GÖRÜNTÜYÜ BAŞLAT (İZLEYİCİ)"
        android:backgroundTint="#00C853"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnHost"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="BU CİHAZDAN YAYIN AÇ (S26)"
        android:backgroundTint="#2979FF"
        android:textColor="#FFFFFF"/>

</LinearLayout>
